/* YTSDownloader SuiteDark — original dark suite theme */

* {
    font-family: "Segoe UI", "Noto Sans", "DejaVu Sans", sans-serif;
    font-size: 13px;
    color: #e8e8e8;
}

QMainWindow, QWidget#centralRoot {
    background-color: #121212;
}

QWidget#sidebar {
    background-color: #000000;
    border-right: 1px solid #282828;
}

QLabel#brandTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1db954;
    padding: 16px 12px 8px 12px;
    border: none;
}

QLabel#brandSub {
    font-size: 11px;
    color: #b3b3b3;
    padding: 0 12px 16px 12px;
    border: none;
}

QPushButton.navBtn {
    text-align: left;
    padding: 10px 16px;
    border: none;
    border-radius: 4px;
    background: transparent;
    color: #b3b3b3;
    font-weight: 600;
}
QPushButton.navBtn:hover {
    color: #ffffff;
    background-color: #181818;
}
QPushButton.navBtn:checked {
    color: #ffffff;
    background-color: #282828;
}

QWidget#contentPane {
    background-color: #121212;
}

QLabel#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #ffffff;
    border: none;
    padding: 8px 0 4px 0;
}

QLabel#pageHint {
    color: #b3b3b3;
    border: none;
}

QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #242424;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #1db954;
}

QPushButton {
    background-color: #1db954;
    color: #000000;
    border: none;
    border-radius: 20px;
    padding: 8px 18px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: #1ed760;
}
QPushButton:disabled {
    background-color: #535353;
    color: #b3b3b3;
}
QPushButton.secondary {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #727272;
}
QPushButton.secondary:hover {
    border-color: #ffffff;
}

QProgressBar {
    background-color: #282828;
    border: none;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
    height: 12px;
}
QProgressBar::chunk {
    background-color: #1db954;
    border-radius: 4px;
}

QTableWidget {
    background-color: #181818;
    alternate-background-color: #121212;
    gridline-color: #282828;
    border: none;
    selection-background-color: #282828;
    selection-color: #ffffff;
}
QHeaderView::section {
    background-color: #121212;
    color: #b3b3b3;
    border: none;
    border-bottom: 1px solid #282828;
    padding: 8px;
    font-weight: 600;
}

QRadioButton, QCheckBox, QLabel {
    border: none;
}

QStatusBar {
    background-color: #181818;
    color: #b3b3b3;
    border-top: 1px solid #282828;
}

QScrollBar:vertical {
    background: #121212;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: #535353;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QComboBox {
    background-color: #242424;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 6px 10px;
}
QComboBox QAbstractItemView {
    background-color: #242424;
    selection-background-color: #1db954;
    selection-color: #000000;
}

QSplitter::handle {
    background-color: #282828;
}
