<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape-friendly panel layout with larger controls for Quest pointing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/quest_pad"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/parityNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/quest_gap"
        android:text="@string/parity_note"
        android:textAppearance="?attr/textAppearanceBody1"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/url_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textUri"
                android:imeOptions="actionDone"
                android:maxLines="3"
                android:minHeight="@dimen/quest_btn_min_height"
                android:textSize="20sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/quest_btn_min_height"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/quest_gap"
            android:minWidth="120dp"
            android:text="@string/add_url"
            android:textSize="18sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/exportFolderLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/quest_gap"
        android:paddingBottom="4dp"
        android:text="@string/export_folder_none"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingEnd="8dp"
            android:text="@string/preset_label"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/presetSpinner"
            android:layout_width="0dp"
            android:layout_height="@dimen/quest_btn_min_height"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/workers_label"
            android:textSize="16sp" />

        <Spinner
            android:id="@+id/workersSpinner"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/quest_btn_min_height"
            android:minWidth="72dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cookieLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="@string/cookies_label_none"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textSize="16sp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickFolderButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:text="@string/pick_export_folder"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pickCookiesButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/pick_cookies"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearCookiesButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/clear_cookies"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/export_inbox"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/exportDownloadsButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/export_downloads"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/share_payload"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/downloadQueueButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/download_queue"
                android:textSize="16sp" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/watermarkSwitch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:minWidth="200dp"
                android:text="@string/watermark_toggle"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/quest_btn_min_height"
                android:layout_marginStart="@dimen/quest_gap"
                android:text="@string/clear_queue"
                android:textSize="16sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="@dimen/quest_gap"
        android:paddingBottom="4dp"
        android:text="@string/queue_title"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/emptyLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/empty_queue"
        android:textSize="18sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/queueList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        tools:listitem="@layout/item_queue" />
</LinearLayout>
